{
  "name": "codex-token-statusbar",
  "version": "1.4.0",
  "displayVersion": "V1.4",
  "private": true,
  "description": "Local, read-only Codex Desktop token and context status bar, adapted from zcode-token-usage-statusbar.",
  "main": "src/main.cjs",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/3ALLBUY14/codex-token-statusbar.git" },
  "bugs": { "url": "https://github.com/3ALLBUY14/codex-token-statusbar/issues" },
  "homepage": "https://github.com/3ALLBUY14/codex-token-statusbar#readme",
  "scripts": {
    "prestart": "node scripts/build-helper.cjs",
    "build:helper": "node scripts/build-helper.cjs",
    "verify:helper": "node scripts/verify-helper.cjs",
    "benchmark:helper": "node scripts/benchmark-helper.cjs",
    "benchmark:store": "node scripts/benchmark-store.cjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "diagnose": "node scripts/diagnose.cjs",
    "package": "node scripts/package.cjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}
